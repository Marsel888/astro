# Canonical URLs, hreflang and the sitemap are all built from SITE_URL.
# The app refuses to start in production without it.
DOMAIN=localhost
SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

DB_PASSWORD=meridian
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian

# Session cookies are signed with this. Required in production — there is no
# fallback, so a missing value fails the boot instead of shipping a known secret.
AUTH_SECRET=replace-with-32-plus-characters-secret
BETTER_AUTH_SECRET=replace-with-32-plus-characters-secret

# Google Cloud Console → APIs & Services → Credentials → Create OAuth client (Web application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs:     http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Not wired up yet:
#   REDIS_URL         — src/lib/rateLimit.ts is per-process memory. Add a Redis
#                       client before running more than one instance.
#   OPENROUTER_API_KEY — no model calls anywhere; interpretations are handwritten.
