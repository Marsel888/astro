# Copy to .env and fill in. docker compose refuses to start if any of the
# required values below is missing, rather than falling back to a dev default.

# ── Required ──────────────────────────────────────────────────────────────────

# The public origin, with scheme and no trailing slash.
# Used at BUILD time as well as at run time: canonical tags, hreflang and the
# sitemap are compiled into the statically generated pages. Changing it means
# rebuilding the image, not just restarting it.
SITE_URL=https://siderachart.com

# The bare hostname Caddy requests a certificate for. No scheme.
# Its DNS A/AAAA record must already point at this server.
DOMAIN=siderachart.com

# Postgres password. Set once, before the first start — it is baked into the
# database volume on creation and changing it later will not re-provision.
DB_PASSWORD=

# Signs the session cookies. Generate with:  openssl rand -hex 32
# There is no fallback in production: a missing value fails the boot instead of
# shipping a secret that lives in this repository.
BETTER_AUTH_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Google sign-in. Leave both blank to offer email and password only.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web):
#   Authorized JavaScript origins:  https://siderachart.com
#   Authorized redirect URIs:       https://siderachart.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Not wired up ──────────────────────────────────────────────────────────────
# REDIS_URL          the cache service runs, but src/lib/rateLimit.ts is still
#                    per-process memory. Add a Redis client before scaling the
#                    app to more than one replica.
# OPENROUTER_API_KEY no model calls anywhere; every interpretation is handwritten.

# ── Local development ─────────────────────────────────────────────────────────
# docker compose -f docker-compose.dev.yml up -d   # Postgres and Redis only
# DATABASE_URL is read directly by `npm run dev`; compose builds it for the
# container from DB_PASSWORD.
# DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
# BETTER_AUTH_URL=http://localhost:3000
